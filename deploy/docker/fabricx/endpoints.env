# Runtime wiring for the Fabric-X stack. These SC_* variables override the
# sample YAMLs baked into the image (viper reads them), so the same image serves
# every role without per-role config files.
#
# TLS is off throughout: this is a local single-host benchmark network, and the
# upstream services are started the same way (`--insecure`).
#
# The TLS modes must live here, not in the image's run.sh: the upstream sample
# YAMLs default every server and client to mtls, and `docker compose exec` (the
# namespace bootstrap in up.sh) starts a fresh process that never runs run.sh.
# That loadgen then spoke TLS to Arma's plaintext router and failed with
# "first record does not look like a TLS handshake". env_file is part of the
# container's environment, so exec'd processes inherit it.
SC_COORDINATOR_SERVER_TLS_MODE=none
SC_COORDINATOR_VERIFIER_TLS_MODE=none
SC_COORDINATOR_VALIDATOR_COMMITTER_TLS_MODE=none
SC_COORDINATOR_MONITORING_TLS_MODE=none
SC_QUERY_SERVER_TLS_MODE=none
SC_QUERY_MONITORING_TLS_MODE=none
SC_SIDECAR_SERVER_TLS_MODE=none
SC_SIDECAR_MONITORING_TLS_MODE=none
SC_SIDECAR_COMMITTER_TLS_MODE=none
SC_SIDECAR_ORDERER_TLS_MODE=none
SC_VC_SERVER_TLS_MODE=none
SC_VC_MONITORING_TLS_MODE=none
SC_VERIFIER_SERVER_TLS_MODE=none
SC_VERIFIER_MONITORING_TLS_MODE=none
SC_ORDERER_SERVER_TLS_MODE=none
SC_LOADGEN_SERVER_TLS_MODE=none
SC_LOADGEN_MONITORING_TLS_MODE=none
SC_LOADGEN_ORDERER_CLIENT_SIDECAR_CLIENT_TLS_MODE=none
SC_LOADGEN_ORDERER_CLIENT_ORDERER_TLS_MODE=none

# Committer pipeline: coordinator and verifier share fabricx-pipeline, so they
# talk over loopback; the validator-committer is a separate container.
SC_COORDINATOR_VERIFIER_ENDPOINTS=127.0.0.1:5001
SC_COORDINATOR_VALIDATOR_COMMITTER_ENDPOINTS=172.29.0.13:6001
SC_SIDECAR_COMMITTER_ENDPOINT=127.0.0.1:9001
SC_SIDECAR_LEDGER_PATH=/data/ledger
SC_SIDECAR_ORDERER_FAULT_TOLERANCE_LEVEL=BFT

# State store.
SC_VC_DATABASE_ENDPOINTS=172.29.0.11:5432
SC_QUERY_DATABASE_ENDPOINTS=172.29.0.11:5432

# Ordering. Broadcast to party 1's router, deliver from its assembler; used by
# the deploy-time namespace bootstrap that runs inside the arma container.
SC_LOADGEN_LOAD_PROFILE_POLICY_CHANNEL_ID=arma
SC_LOADGEN_LOAD_PROFILE_POLICY_ORDERER_ENDPOINTS=id=1,broadcast,172.29.0.10:6022
SC_LOADGEN_ORDERER_CLIENT_SIDECAR_CLIENT_ENDPOINT=172.29.0.12:4001
