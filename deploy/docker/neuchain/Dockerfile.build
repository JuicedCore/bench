# NeuChain compile stage. Builds block_server / epoch_server / user ON TOP of
# NeuChain's own build-environment image (which runs the repo's install_deps.sh:
# gperftools, leveldb, gflags, glog, zlib(-ng), protobuf 3.19.4, brpc, braft,
# yaml-cpp, libzmq/cppzmq, libpqxx - ~15 libs from source, Ubuntu 20.04).
#
# build.sh builds the deps image first (bench/neuchain-deps:<ref>) from the
# cloned repo's Dockerfile, then this stage.
#
#   docker build -f Dockerfile.build \
#     --build-arg DEPS_IMAGE=bench/neuchain-deps:ev \
#     --build-arg NEUCHAIN_SRC=.cache/NeuChain \
#     -t bench/neuchain-build:ev .
ARG DEPS_IMAGE=bench/neuchain-deps:ev
FROM ${DEPS_IMAGE}

ARG BUILD_TARGETS="block_server_test_comm epoch_server user"
ARG BUILD_JOBS=4

# The repo's own Dockerfile ADDs the source to /root/neuchain during the deps
# image build, so it is already present. Rebuild targets here.
WORKDIR /root/neuchain

# Optional CMakeLists fix-ups (the repo README notes edits may be needed).
COPY cmakelists.patc[h] /tmp/cmakelists.patch
RUN if [ -s /tmp/cmakelists.patch ]; then \
      echo "applying cmakelists.patch"; \
      (git apply --verbose /tmp/cmakelists.patch || patch -p1 < /tmp/cmakelists.patch); \
    fi

RUN cmake -S . -B build -D CMAKE_BUILD_TYPE=Release \
 && cmake --build build -j"${BUILD_JOBS}" --target ${BUILD_TARGETS} \
 && mkdir -p /out && find build -maxdepth 4 -type f -perm -u+x \
      \( -name 'block_server*' -o -name 'epoch_server*' -o -name 'user*' \) -exec cp {} /out/ \; \
 && mkdir -p /out/proto && find include -name '*.proto' -exec cp --parents {} /out/proto/ \; \
 && cp -r doc /out/doc \
 && (git rev-parse HEAD > /out/COMMIT || true) \
 && ls -l /out
