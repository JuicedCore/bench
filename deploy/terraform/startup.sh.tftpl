#!/bin/bash
# Rendered by Terraform into the VM's startup-script metadata. Runs on every boot;
# install-deps.sh is idempotent, and --tune re-applies settings that do not
# survive a reboot (transparent huge pages).
set -euo pipefail
mkdir -p /var/lib/bench
# Clear both markers: a stale "failed" from an earlier boot would make
# scripts/gcp-run.sh give up while this boot's install is still running.
rm -f /var/lib/bench/ready /var/lib/bench/failed
cat > /var/lib/bench/install-deps.sh <<'INSTALL_DEPS_EOF'
${install_deps}
INSTALL_DEPS_EOF
echo "bench install started $(date -u +%FT%TZ)" > /var/log/bench-install.log
if bash /var/lib/bench/install-deps.sh --tune >> /var/log/bench-install.log 2>&1; then
  date -u +%FT%TZ > /var/lib/bench/ready
else
  rc=$?
  echo "install-deps failed with exit $rc at $(date -u +%FT%TZ); last line: $(tail -1 /var/log/bench-install.log)" > /var/lib/bench/failed
fi
