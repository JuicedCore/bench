<!doctype html>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Monitoring report — {{.Platform}} / {{.Workload}}</title>
<style>
  :root {
    --bg: #f4f5f7;
    --card: #ffffff;
    --border: #e3e5e9;
    --text: #1c1f26;
    --muted: #6b7280;
    --accent: #2563eb;
    --accent-soft: #eff4ff;
    --danger: #b3261e;
    --danger-bg: #fdecea;
    --danger-border: #f2b8b0;
    --ok: #16794f;
    --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, monospace;
    --radius: 10px;
    --shadow: 0 1px 2px rgba(20,20,30,.04), 0 1px 8px rgba(20,20,30,.04);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #14161b;
      --card: #1c1f26;
      --border: #2c303a;
      --text: #e7e9ee;
      --muted: #9aa1ac;
      --accent: #6ea8fe;
      --accent-soft: #1c2942;
      --danger: #ff8a80;
      --danger-bg: #3a1f1e;
      --danger-border: #6b2f2a;
      --ok: #5fd8a6;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 1px 8px rgba(0,0,0,.3);
    }
  }
  * { box-sizing: border-box; }
  body {
    font: 14px/1.55 -apple-system, "Segoe UI", system-ui, sans-serif;
    margin: 0;
    color: var(--text);
    background: var(--bg);
  }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }

  header.top { margin-bottom: 1.5rem; }
  h1 { font-size: 1.5rem; margin: 0 0 .6rem; letter-spacing: -.01em; }
  .chips { display: flex; flex-wrap: wrap; gap: .4rem; align-items: center; margin-bottom: .4rem; }
  .chip {
    display: inline-flex; align-items: center; gap: .3rem;
    font-size: .78rem; font-weight: 600; padding: .22rem .6rem;
    border-radius: 999px; background: var(--accent-soft); color: var(--accent);
    border: 1px solid transparent;
  }
  .chip.muted { background: transparent; color: var(--muted); border-color: var(--border); font-weight: 500; }
  .timerange { color: var(--muted); font-size: .85rem; }
  .timerange strong { color: var(--text); font-weight: 600; }

  .banner {
    background: var(--danger-bg); border: 1px solid var(--danger-border); color: var(--text);
    border-radius: var(--radius); padding: .9rem 1.1rem; margin: 0 0 1.5rem; box-shadow: var(--shadow);
  }
  .banner .head { display: flex; align-items: center; gap: .45rem; font-weight: 700; color: var(--danger); margin-bottom: .3rem; }
  .banner ul { margin: 0; padding-left: 1.2rem; }
  .banner li { margin: .15rem 0; }

  section.card {
    background: var(--card); border: 1px solid var(--border); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 1.3rem 1.4rem; margin-bottom: 1.4rem;
  }
  section.card > h2 {
    font-size: .95rem; text-transform: uppercase; letter-spacing: .04em;
    color: var(--muted); margin: 0 0 1rem; font-weight: 700;
  }

  .kv { display: grid; grid-template-columns: max-content 1fr; gap: .5rem 1.5rem; }
  .kv dt { color: var(--muted); font-weight: 600; white-space: nowrap; }
  .kv dd { margin: 0; font-family: var(--mono); font-size: .88rem; word-break: break-word; }
  .kv dd.caveat { font-family: inherit; color: var(--danger); }
  .kv dd.caveat div { margin-bottom: .2rem; }

  table { border-collapse: collapse; width: 100%; font-size: .86rem; }
  table.metrics th, table.metrics td { padding: .5rem .7rem; text-align: right; white-space: nowrap; }
  table.metrics th { color: var(--muted); font-weight: 600; border-bottom: 2px solid var(--border); font-size: .78rem; text-transform: uppercase; letter-spacing: .03em; }
  table.metrics td { border-bottom: 1px solid var(--border); font-family: var(--mono); }
  table.metrics td:first-child, table.metrics th:first-child { text-align: left; font-family: inherit; font-weight: 600; }
  table.metrics tbody tr:last-child td { border-bottom: none; }
  table.metrics tbody tr:hover td { background: var(--accent-soft); }
  .table-scroll { overflow-x: auto; }

  .note { color: var(--muted); font-size: .82rem; margin: .8rem 0 0; line-height: 1.6; }
  .note b { color: var(--text); font-weight: 600; }

  .charts-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 1.1rem; }
  .chart { border: 1px solid var(--border); border-radius: var(--radius); padding: .9rem .9rem 1rem; background: var(--card); }
  .chart .chart-title { font-weight: 600; font-size: .85rem; margin-bottom: .5rem; }
  .chart img { max-width: 100%; display: block; border-radius: 6px; }
  .chart .explain { color: var(--muted); font-size: .8rem; margin-top: .55rem; line-height: 1.5; }
  .placeholder {
    color: var(--muted); font-style: italic; font-size: .85rem;
    padding: 2.2rem 1rem; text-align: center; border: 1px dashed var(--border); border-radius: 6px;
  }

  .footer { color: var(--muted); font-size: .8rem; margin-top: 2.5rem; border-top: 1px solid var(--border); padding-top: 1rem; }

  .stats { display: flex; flex-wrap: wrap; gap: 1.6rem; }
  .stat-label { color: var(--muted); font-size: .74rem; text-transform: uppercase; letter-spacing: .04em; margin-bottom: .2rem; }
  .stat-value { font-family: var(--mono); font-size: 1.35rem; font-weight: 600; }
  .stat-value.bad { color: var(--danger); }
  .stat-value.ok { color: var(--ok); }

  details.phase { border: 1px solid var(--border); border-radius: 8px; margin-top: .7rem; padding: .6rem .8rem; }
  details.phase summary { cursor: pointer; font-weight: 600; font-size: .85rem; }
  details.phase summary .window { color: var(--muted); font-weight: 400; font-family: var(--mono); font-size: .78rem; margin-left: .6rem; }
  table.pctl { margin-top: .7rem; }
  table.pctl th, table.pctl td { padding: .3rem .6rem; }
</style>

<div class="wrap">

<header class="top">
  <h1>{{.RunName}}</h1>
  <div class="chips">
    <span class="chip">{{.Platform}}{{if .PlatformVersion}} · {{.PlatformVersion}}{{end}}</span>
    <span class="chip muted">workload {{.Workload}}</span>
    <span class="chip muted">profile {{.Profile}}</span>
    <span class="chip muted">normalized={{.Normalized}}</span>
  </div>
  <div class="timerange"><strong>{{fmtTime .Manifest.StartedAt}}</strong> → <strong>{{fmtTime .Manifest.EndedAt}}</strong> &nbsp;({{duration .Manifest.StartedAt .Manifest.EndedAt}})</div>
</header>

{{if .Banner}}
<div class="banner">
  <div class="head">&#9888; Needs attention</div>
  <ul>
    {{range .Banner}}<li>{{.}}</li>{{end}}
  </ul>
</div>
{{end}}

{{if .Headline}}
<section class="card">
  <h2>Headline result</h2>
  <div class="stats">
    <div class="stat"><div class="stat-label">confirmed tps</div><div class="stat-value">{{printf "%.1f" .Headline.ConfirmedTPS}}</div></div>
    <div class="stat"><div class="stat-label">fail rate</div><div class="stat-value{{if gt .Headline.FailureRate 0.0}} bad{{end}}">{{printf "%.2f%%" (mulf .Headline.FailureRate 100)}}</div></div>
    <div class="stat"><div class="stat-label">e2e p50 / p99 ms</div><div class="stat-value">{{printf "%.1f" (pctl .Headline.E2E "p50")}} / {{printf "%.1f" (pctl .Headline.E2E "p99")}}</div></div>
    <div class="stat"><div class="stat-label">invariant</div><div class="stat-value {{if .Headline.InvariantOK}}ok{{else}}bad{{end}}">{{if .Headline.InvariantOK}}&#10003; ok{{else}}&#10007; broken{{end}}</div></div>
    {{if gt .SaturationTPS 0}}<div class="stat"><div class="stat-label">saturation</div><div class="stat-value">~{{.SaturationTPS}} tps</div></div>{{end}}
  </div>
  <p class="note">{{headlineExplanation}}{{if gt .SaturationTPS 0}} {{saturationExplanation}}{{end}}</p>
</section>
{{end}}

<section class="card">
  <h2>Experiment control settings</h2>
  <dl class="kv">
    <dt>State DB</dt><dd>{{.Manifest.StateDB}}</dd>
    <dt>Orderer batch</dt><dd>msgcount={{.Manifest.OrdererBatch.MaxMessageCount}} timeout={{.Manifest.OrdererBatch.BatchTimeout}} preferred={{.Manifest.OrdererBatch.PreferredMaxBytes}} max={{.Manifest.OrdererBatch.AbsoluteMaxBytes}}</dd>
    <dt>Crypto</dt><dd>sig={{.Manifest.Crypto.SignatureAlg}} hash={{.Manifest.Crypto.HashAlg}} per_tx_endorse_verify={{.Manifest.Crypto.PerTxEndorsementVerify}}{{if .Manifest.Crypto.MSPNote}} ({{.Manifest.Crypto.MSPNote}}){{end}}</dd>
    <dt>Resource limit / container</dt><dd>{{.Manifest.ResourceLimit.CPUs}} CPUs, {{.Manifest.ResourceLimit.Memory}} memory</dd>
    <dt>Nodes</dt><dd>{{range $role, $n := .Manifest.Nodes}}{{$role}}={{$n}} {{end}}</dd>
    <dt>Load determinism</dt><dd>seed={{.Manifest.Seed}} key_space={{.Manifest.KeySpace}} key_distribution={{.Manifest.KeyDistribution}}{{if .Manifest.ZipfianConstant}} zipfian_constant={{.Manifest.ZipfianConstant}}{{end}} read_write_ratio={{.Manifest.ReadWriteRatio}} value_size_bytes={{.Manifest.ValueSizeBytes}}</dd>
    <dt>Windowing</dt><dd>warmup={{.Manifest.WarmupSec}}s cooldown={{.Manifest.CooldownSec}}s</dd>
    <dt>Harness git SHA</dt><dd>{{.Manifest.HarnessGitSHA}}</dd>
    {{if .Manifest.Caveats}}<dt>Caveats</dt><dd class="caveat">{{range .Manifest.Caveats}}<div>&#9888; {{.}}</div>{{end}}</dd>{{end}}
  </dl>
</section>

<section class="card">
  <h2>Harness result metrics</h2>
  <div class="table-scroll">
  <table class="metrics">
    <thead><tr>
      <th>phase</th><th>offered tps</th><th>confirmed tps</th><th>fail rate</th>
      <th>submitted</th><th>committed</th><th>invalid</th><th>errored</th><th>timed out</th>
      <th>e2e p50 ms</th><th>e2e p99 ms</th><th>submit p50 ms</th><th>commit p50 ms</th><th>send-gap p99 ms</th>
    </tr></thead>
    <tbody>
    {{range .Phases}}
    <tr>
      <td>{{.Name}}</td><td>{{.OfferedTPS}}</td><td>{{printf "%.1f" .Result.ConfirmedTPS}}</td><td>{{printf "%.4f" .Result.FailureRate}}</td>
      <td>{{.Result.Submitted}}</td><td>{{.Result.Committed}}</td><td>{{.Result.Invalid}}</td><td>{{.Result.Errored}}</td><td>{{.Result.TimedOut}}</td>
      <td>{{printf "%.2f" (pctl .Result.E2E "p50")}}</td><td>{{printf "%.2f" (pctl .Result.E2E "p99")}}</td>
      <td>{{printf "%.2f" (pctl .Result.Submit "p50")}}</td><td>{{printf "%.2f" (pctl .Result.Commit "p50")}}</td>
      <td>{{printf "%.2f" (pctl .Result.SendGap "p99")}}</td>
    </tr>
    {{end}}
    </tbody>
  </table>
  </div>
  <p class="note">
    <b>confirmed_tps</b>: {{explain "ConfirmedTPS"}} &nbsp;·&nbsp;
    <b>fail_rate</b>: {{explain "FailureRate"}} &nbsp;·&nbsp;
    <b>e2e</b>: {{explain "E2E"}} &nbsp;·&nbsp;
    <b>submit</b>: {{explain "Submit"}} &nbsp;·&nbsp;
    <b>commit</b>: {{explain "Commit"}} &nbsp;·&nbsp;
    <b>send-gap</b>: {{explain "SendGap"}}
  </p>

  {{range .Phases}}
  <details class="phase"{{if eq (len $.Phases) 1}} open{{end}}>
    <summary>{{.Name}} — full percentile detail
      <span class="window">window {{fmtTime .Window.WinStart}} → {{fmtTime .Window.WinEnd}} (phase started {{fmtTime .Window.PhaseStart}})</span>
    </summary>
    <div class="table-scroll">
    <table class="metrics pctl">
      <thead><tr><th>percentile</th><th>e2e ms</th><th>submit ms</th><th>commit ms</th><th>send-gap ms</th></tr></thead>
      <tbody>
      {{range .LatencyRows}}
      <tr><td>{{.Pct}}</td><td>{{printf "%.2f" .E2E}}</td><td>{{printf "%.2f" .Submit}}</td><td>{{printf "%.2f" .Commit}}</td><td>{{printf "%.2f" .SendGap}}</td></tr>
      {{end}}
      <tr><td>count</td><td>{{.Result.E2E.Count}}</td><td>{{.Result.Submit.Count}}</td><td>{{.Result.Commit.Count}}</td><td>{{.Result.SendGap.Count}}</td></tr>
      <tr><td>min ms</td><td>{{printf "%.2f" .Result.E2E.MinMs}}</td><td>{{printf "%.2f" .Result.Submit.MinMs}}</td><td>{{printf "%.2f" .Result.Commit.MinMs}}</td><td>{{printf "%.2f" .Result.SendGap.MinMs}}</td></tr>
      <tr><td>max ms</td><td>{{printf "%.2f" .Result.E2E.MaxMs}}</td><td>{{printf "%.2f" .Result.Submit.MaxMs}}</td><td>{{printf "%.2f" .Result.Commit.MaxMs}}</td><td>{{printf "%.2f" .Result.SendGap.MaxMs}}</td></tr>
      <tr><td>mean ms</td><td>{{printf "%.2f" .Result.E2E.MeanMs}}</td><td>{{printf "%.2f" .Result.Submit.MeanMs}}</td><td>{{printf "%.2f" .Result.Commit.MeanMs}}</td><td>{{printf "%.2f" .Result.SendGap.MeanMs}}</td></tr>
      <tr><td>stddev ms</td><td>{{printf "%.2f" .Result.E2E.StdDevMs}}</td><td>{{printf "%.2f" .Result.Submit.StdDevMs}}</td><td>{{printf "%.2f" .Result.Commit.StdDevMs}}</td><td>{{printf "%.2f" .Result.SendGap.StdDevMs}}</td></tr>
      </tbody>
    </table>
    </div>
    <p class="note">{{percentileTableNote}}</p>
  </details>
  {{end}}
</section>

<section class="card">
  <h2>Host + container resource metrics</h2>
  {{if .SystemSampleCharts}}
    <div class="charts-grid">
    {{range .SystemSampleCharts}}
    <div class="chart">
      <div class="chart-title">{{.Title}}</div>
      {{if .Rendered}}<img src="{{.ImgDataURI | safeURL}}" alt="{{.Title}}">
      {{else}}<div class="placeholder">no data in this window</div>{{end}}
      {{if .Explanation}}<div class="explain">{{.Explanation}}</div>{{end}}
    </div>
    {{end}}
    </div>
  {{end}}
  {{if .MonitoringSkipped}}
    <p class="placeholder">Monitoring disabled for this run: {{.MonitoringSkipped}}</p>
  {{else if .MonitoringUnavailable}}
    <p class="placeholder">Prometheus/cAdvisor charts unavailable — see banner above. Harness sampling above still applies.</p>
  {{else}}
    {{if .OverviewNote}}<p class="note">{{.OverviewNote}}</p>{{end}}
    <div class="charts-grid">
    {{range .OverviewCharts}}
    <div class="chart">
      <div class="chart-title">{{.Title}}</div>
      {{if .Rendered}}<img src="{{.ImgDataURI | safeURL}}" alt="{{.Title}}">
      {{else if .HasData}}<div class="placeholder">data was fetched but could not be rendered — see banner above</div>
      {{else}}<div class="placeholder">no data in this window</div>{{end}}
      {{if .Explanation}}<div class="explain">{{.Explanation}}</div>{{end}}
    </div>
    {{end}}
    </div>
  {{end}}
</section>

<section class="card">
  <h2>Native platform metrics</h2>
  {{if .MonitoringSkipped}}
    <p class="placeholder">Monitoring disabled for this run: {{.MonitoringSkipped}}</p>
  {{else if .MonitoringUnavailable}}
    <p class="placeholder">Monitoring unavailable — see banner above.</p>
  {{else}}
    {{if .PerPlatformNote}}<p class="note">{{.PerPlatformNote}}</p>{{end}}
    <div class="charts-grid">
    {{range .PerPlatformCharts}}
    <div class="chart">
      <div class="chart-title">{{.Title}}</div>
      {{if .Rendered}}<img src="{{.ImgDataURI | safeURL}}" alt="{{.Title}}">
      {{else if .HasData}}<div class="placeholder">data was fetched but could not be rendered — see banner above</div>
      {{else}}<div class="placeholder">no data in this window</div>{{end}}
      {{if .Explanation}}<div class="explain">{{.Explanation}}</div>{{end}}
    </div>
    {{end}}
    </div>
  {{end}}
</section>

{{if .NativeScrapes}}
<section class="card">
  <h2>Native /metrics raw values</h2>
  <p class="note">{{nativeScrapeCaveat}}</p>
  {{range .NativeScrapes}}
  <h3 style="font-size:.85rem;margin:1rem 0 .4rem;font-family:var(--mono);color:var(--muted)">{{.Endpoint}} <span style="font-weight:400">({{fmtTime .T}})</span></h3>
  <div class="table-scroll">
  <table class="metrics">
    <thead><tr><th>metric</th><th>value</th></tr></thead>
    <tbody>
    {{range $name, $val := .Values}}
    <tr><td>{{$name}}</td><td>{{printf "%.4f" $val}}</td></tr>
    {{end}}
    </tbody>
  </table>
  </div>
  {{end}}
</section>
{{end}}

<div class="footer">
  Generated {{fmtTime .GeneratedAt}} by benchrunner — everything from manifest.json, result.json and this run's monitoring window is above; no need to open those files separately.
</div>

</div>
